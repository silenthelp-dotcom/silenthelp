# Copy frontend values into frontend/.env. Leave demo false in production.
VITE_DEMO_MODE=false
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
# Server ONLY: Edge secrets and bootstrap. Never prefix these with VITE_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
APP_URL=http://localhost:5173
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM=SilentHelp HQ <hq@YOUR_VERIFIED_DOMAIN>
WORKER_SECRET=GENERATE_A_LONG_RANDOM_SECRET
# OpenAI-compatible chat completions endpoint, approved by your organization.
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=YOUR_SERVER_SIDE_AI_KEY
AI_MODEL=YOUR_MODEL_ID
BOOTSTRAP_EMAIL=admin@YOUR_DOMAIN
BOOTSTRAP_NAME=SilentHelp Administrator
